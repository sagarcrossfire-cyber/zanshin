{
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@netlify/blobs": "^11.1.7",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0",
    "recharts": "3.10.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "description": "ZANSHIN — personal Tekken 8 Yoshimitsu coaching app (local-first PWA). Unofficial personal training tool, not affiliated with Bandai Namco.",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.36.0",
    "@netlify/functions": "^6.0.3",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.14.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "6.1.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.1",
    "vite": "6.3.6",
    "vite-plugin-pwa": "1.0.3",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "zanshin",
  "private": true,
  "scripts": {
    "prebuild": "tsx scripts/rasterize-icons.ts && node scripts/ensure-media-manifest.mjs",
    "build": "vite build",
    "dev": "vite",
    "import:wavu": "tsx scripts/import-wavu.ts",
    "lint": "eslint . && node scripts/check-no-colors.mjs && node scripts/check-boundaries.mjs",
    "preview": "vite preview --port 4173",
    "rasterize-icons": "tsx scripts/rasterize-icons.ts",
    "test": "vitest run",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:media-script": "python3 scripts/tests/test_media_pack.py",
    "media:site": "python3 scripts/make_zanshin_media_pack.py --site-dir public --cache-dir .zanshin-media-cache",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "verify": "npm run verify:quick && npm run validate:data && npm run build && node scripts/check-bundle.mjs && npm run test:e2e",
    "verify:quick": "npm run typecheck && npm run lint && npm run test",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "doctor": "node scripts/doctor.mjs"
  },
  "type": "module",
  "version": "1.4.1"
}
